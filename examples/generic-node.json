{
  "version": 3,
  "activeProfile": "web",
  "defaults": {
    "executor": {
      "provider": "opencode",
      "model": null,
      "timeoutMs": 2700000,
      "permissionMode": "auto"
    },
    "limits": {
      "maxDeliveriesPerDay": 10,
      "maxReviewsPerDay": 20,
      "maxDiscoveriesPerDay": 5,
      "maxAuxPerCycle": 4,
      "maxActiveClaims": 2,
      "maxAttemptsPerTask": 3,
        "maxNetworkRetries": 5,
        "networkRetryMinutes": 1,
      "maxCyclesBeforeDiscovery": 6,
      "maxOpenEscalations": 5,
      "maxRuntimeMinutes": 120,
      "maxCycles": null,
      "stopAt": null,
      "maxDeliveriesTotal": null,
      "maxConcurrentDeliveries": 2,
      "maxConcurrentReviews": 1,
      "maxConcurrentAux": 2,
      "maxConcurrentDiscovery": 1,
      "maxConcurrentAgents": 4,
      "maxTokensPerRun": null,
      "tokenWarnPercent": 80,
      "providerRetryMinutes": 15
    },
    "pollSeconds": 120,
    "memoryRefreshMinutes": 30,
    "hitl": {
      "enabled": true,
      "defaultType": "question",
      "notifyCommand": null,
      "notify": "auto"
    },
    "workflow": {
      "maxFiles": 5,
      "maxLines": 400,
      "branchPrefix": "fix",
      "commitTypes": [
        "fix",
        "feat",
        "test",
        "refactor",
        "chore",
        "docs",
        "perf",
        "security"
      ],
      "requireTests": true
    }
  },
  "profiles": {
    "web": {
      "ziki": {
        "baseUrl": "https://ziki.dev",
        "projectId": "REPLACE_WITH_PROJECT_ID",
        "projectSlug": "REPLACE_WITH_PROJECT_SLUG",
        "platform": "web",
        "projectName": "My Web App"
      },
      "stack": "Next.js + TypeScript",
      "repo": {
        "url": "REPLACE_WITH_YOUR_FORK_CLONE_URL",
        "upstream": "REPLACE_WITH_UPSTREAM_URL",
        "base": "main",
        "githubRepo": "REPLACE_WITH_OWNER/REPO",
        "forkOwner": "REPLACE_WITH_FORK_OWNER",
        "defaultBranch": "main",
        "teamLead": "",
        "envFiles": [
          ".env",
          ".env.local"
        ],
        "requiredEnv": []
      },
      "agents": {
        "workers": [
          "ZIKI_KEY1"
        ],
        "managers": [
          "ZIKI_KEY2"
        ]
      },
      "toolchain": {
        "git": "git",
        "gh": "gh"
      },
      "checks": [
        {
          "name": "deps",
          "command": "npm",
          "args": [
            "ci"
          ],
          "timeoutMs": 600000
        },
        {
          "name": "lint",
          "command": "npm",
          "args": [
            "run",
            "lint"
          ],
          "required": false
        },
        {
          "name": "test",
          "command": "npm",
          "args": [
            "test"
          ],
          "timeoutMs": 1800000
        }
      ],
      "platformMatch": {
        "keywords": [
          "web",
          "next",
          "browser"
        ]
      },
      "prompts": {
        "dir": "prompts/generic"
      },
      "pr": {
        "templateFile": "prompts/generic/pr.md"
      },
      "discovery": {
        "enabled": false,
        "maxIdeasPerRun": 3
      }
    }
  }
}
