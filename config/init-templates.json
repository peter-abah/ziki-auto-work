      "health.retryMs.*"
    ],
    "allowNewKeys": [
      "ziki.platformFilter",
      "ziki.orgSlug",
      "queue.priorities.*",
      "ziki.endpoints.*",
      "operations.*"
    ],
    "strategies": {
      "platform:not_found": {
        "enabled": true,
        "role": "configDoctor",
        "maxRounds": 3
      },
      "feed:not_found": {
        "enabled": true,
        "role": "configDoctor",
        "maxRounds": 3
      },
      "*:not_found": {
        "enabled": true,
        "role": "configDoctor",
        "maxRounds": 2
      },
      "feed:unexpected_response_shape": {
        "enabled": true,
        "role": "configDoctor",
        "maxRounds": 3
      },
      "*:unknown_filter": {
        "enabled": true,
        "role": "configDoctor",
        "maxRounds": 2
      },
      "config:missing_key": {
        "enabled": true,
        "role": "configDoctor",
        "maxRounds": 2
      },
      "config:unknown_endpoint": {
        "enabled": true,
        "role": "configDoctor",
        "maxRounds": 2
      },
      "*:unknown_kind": {
        "enabled": true,
        "role": "configDoctor",
        "maxRounds": 2
      },
      "*:unknown_vocabulary": {
        "enabled": true,
        "role": "configDoctor",
        "maxRounds": 2
      }
    }
  },
  "transport": {
    "authScheme": "Bearer",
    "userAgent": "ziki-auto-work/0.1",
    "defaultTimeoutMs": 60000,
    "defaultRetries": 3,
    "backoffCapMs": 60000,
    "retryGrowthCapMs": 30000,
    "previewChars": 120
