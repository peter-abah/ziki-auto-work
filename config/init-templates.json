      "create": "/api/v1/escalations",
      "get": "/api/v1/escalations/{id}"
    },
    "questions": {
      "create": "/api/v1/questions",
      "get": "/api/v1/questions/{id}"
    },
    "inbox": {
      "list": "/api/v1/inbox",
      "read": "/api/v1/inbox/read"
    }
  },
  "_meta": {
    "configVersion": 4,
    "source": "snapshot of built-in behavior; init writes these explicitly, runtime never falls back to them",
    "note": "Last-known-good values, not truth. Live Ziki wins: init --discover re-resolves project/platform/workflow from the API."
  },
  "limits": {
    "maxActiveClaims": "auto",
    "maxAttemptsPerTask": null,
    "maxNetworkRetries": 5,
    "networkRetryMinutes": 1,
    "maxCyclesBeforeDiscovery": 6,
    "maxOpenEscalations": null,
    "maxRuntimeMinutes": null,
    "maxCycles": null,
    "stopAt": null,
    "maxDeliveriesTotal": null,
    "maxConcurrentDeliveries": "auto",
    "maxConcurrentFollowUps": "auto",
    "maxConcurrentReviews": "auto",
    "maxConcurrentAux": "auto",
    "maxConcurrentDiscovery": 1,
    "maxConcurrentAgents": "auto",
    "maxTokensPerRun": null,
    "tokenWarnPercent": 80,
    "providerRetryMinutes": 15
  },
  "workflow": {
    "maxFiles": 5,
    "maxLines": 400,
    "branchPrefix": "fix",
    "commitTypes": [
      "fix",
      "feat",
      "test",
      "refactor",
      "chore",
      "docs",
      "perf",
      "security"
    ],
    "requireTests": true,
    "autoVoteBids": "agent",
    "autoUpvoteComments": "agent"
  },
  "prTracking": {
    "enabled": true,
    "pollMinutes": 10,
    "maxFollowUps": 10,
    "fixFailingChecks": true,
    "fixReviewComments": true
  },
  "timing": {
    "agentDefaultMs": 2700000,
    "triageMs": 1200000,
    "ownerMs": 1800000,
    "discoveryMs": 2700000,
    "repairMs": 300000,
    "doctorMs": 300000,
    "markRecentMs": 1800000,
    "offlineWatchMs": 900000,
    "offlineFreshMs": 1800000,
    "repoHealthMs": 21600000,
    "heartbeatMs": null,
    "heartbeatDefaultMs": 600000,
    "rateLimitChunkMs": 300000
  },
  "statuses": {
    "workable": [
      "requires_confirmation",
      "open",
      "in_progress"
    ],
    "terminal": [
      "resolved",
      "closed",
      "done",
      "merge",
      "accepted"
    ],
    "terminalSubstatus": [
      "done",
      "merge"
    ],
    "confirmation": [
      "requires_confirmation"
    ],
    "known": [
      "open",
      "requires_confirmation",
      "in_progress",
      "resolved",
      "closed",
      "done",
      "merge",
      "accepted",
      "archived",
      "converted",
      "rejected",
      "on_dev",
      "on_staging",
      "on_prod",
      "ready_issue",
      "test_fix",
      "award_bid",
      "review_bid",
      "review_comment",
      "reclaim_issue",
      "investigate_issue",
      "report_deployment",
      "report_pr_status",
      "categorize",
      "sense_check",
      "active_claim",
      "offer",
      "review_offer",
      "job_review_offer",
      "open_issue",
      "confirm_issue",
      "vote_importance",
      "estimate_reward",
      "refresh_stake",
      "vote_stake",
      "merge_review",
      "close_issue",
      "research_job",
      "review_idle",
      "join_request",
      "idea"
    ]
  },
  "repair": {
    "enabled": true,
    "mutablePaths": [
      "ziki.projectId",
      "ziki.projectSlug",
      "ziki.orgSlug",
      "ziki.platform",
      "ziki.platformCategoryId",
      "ziki.platformFilter",
      "ziki.vars.*",
      "ziki.endpoints.*",
      "operations.*",
      "transport.*",
      "queue.*",
      "reviewGate.*",
      "heartbeatPolicy.*",
      "decisions.*",
      "noop.patterns",
      "votes.*",
      "idea.*",
      "apiRepair.*",
      "capacity.*",
      "urls.*",
      "discover.*",
      "github.*",
      "safety.*",
      "checksDefaults.*",
      "outbox.*",
      "loop.*",
      "offline.*",
      "discovery.*",
      "timing.markRecentMs",
      "timing.offlineWatchMs",
      "timing.offlineFreshMs",
      "timing.repoHealthMs",
      "timing.agentDefaultMs",
      "timing.triageMs",
