{
  "_meta": {
    "configVersion": 4,
    "source": "snapshot of built-in behavior; init writes these explicitly, runtime never falls back to them",
    "note": "Last-known-good values, not truth. Live Ziki wins: init --discover re-resolves project/platform/workflow from the API."
  },
  "limits": {
    "maxActiveClaims": "auto",
    "maxAttemptsPerTask": null,
    "maxNetworkRetries": 5,
    "networkRetryMinutes": 1,
    "maxCyclesBeforeDiscovery": 6,
    "maxOpenEscalations": null,
    "maxRuntimeMinutes": null,
    "maxCycles": null,
    "stopAt": null,
    "maxDeliveriesTotal": null,
    "maxConcurrentDeliveries": "auto",
    "maxConcurrentFollowUps": "auto",
    "maxConcurrentReviews": "auto",
    "maxConcurrentAux": "auto",
    "maxConcurrentDiscovery": 1,
    "maxConcurrentAgents": "auto",
    "maxTokensPerRun": null,
    "tokenWarnPercent": 80,
    "providerRetryMinutes": 15
  },
  "workflow": {
    "maxFiles": 5,
    "maxLines": 400,
    "branchPrefix": "fix",
    "commitTypes": ["fix", "feat", "test", "refactor", "chore", "docs", "perf", "security"],
    "requireTests": true,
    "autoVoteBids": "agent",
    "autoUpvoteComments": "agent"
  },
  "prTracking": {
    "enabled": true,
    "pollMinutes": 10,
    "maxFollowUps": 10,
    "fixFailingChecks": true,
    "fixReviewComments": true
  },
  "timing": {
    "agentDefaultMs": 2700000,
    "triageMs": 1200000,
    "ownerMs": 1800000,
    "discoveryMs": 2700000,
    "repairMs": 300000,
    "doctorMs": 300000,
    "markRecentMs": 1800000,
    "offlineWatchMs": 900000,
    "offlineFreshMs": 1800000,
    "repoHealthMs": 21600000,
    "heartbeatMs": null,
    "heartbeatDefaultMs": 600000,
    "reviewTransientMs": 300000,
    "reviewTerminalMs": 1800000,
    "rateLimitChunkMs": 300000
  },
  "statuses": {
    "workable": ["requires_confirmation", "open", "in_progress"],
    "terminal": ["resolved", "closed", "done", "merge", "accepted"],
    "terminalSubstatus": ["done", "merge"],
    "confirmation": ["requires_confirmation"],
    "known": [
      "open", "requires_confirmation", "in_progress", "resolved", "closed",
      "done", "merge", "accepted", "archived", "converted", "rejected",
      "on_dev", "on_staging", "on_prod",
      "ready_issue", "test_fix", "award_bid", "review_bid", "review_comment",
      "reclaim_issue", "investigate_issue", "report_deployment", "report_pr_status",
      "categorize", "sense_check", "active_claim", "offer", "review_offer",
      "job_review_offer", "open_issue", "confirm_issue", "vote_importance",
      "estimate_reward", "refresh_stake", "vote_stake", "merge_review",
      "close_issue", "research_job", "review_idle", "join_request", "idea"
    ]
  },
  "repair": {
    "enabled": true,
    "mutablePaths": [
      "ziki.projectId",
      "ziki.projectSlug",
      "ziki.orgSlug",
      "ziki.platform",
      "ziki.platformCategoryId",
      "ziki.platformFilter",
      "ziki.vars.*",
      "ziki.endpoints.*",
      "timing.markRecentMs",
      "timing.offlineWatchMs",
      "timing.offlineFreshMs",
      "timing.repoHealthMs",
      "pollSeconds",
      "memoryRefreshMinutes",
      "discovery.enabled",
      "discovery.maxIdeasPerRun"
    ],
    "allowNewKeys": ["ziki.platformFilter", "ziki.orgSlug"],
    "strategies": {
      "platform:not_found": { "enabled": true, "role": "configDoctor", "maxRounds": 3 },
      "feed:unexpected_response_shape": { "enabled": true, "role": "configDoctor", "maxRounds": 3 },
      "*:unknown_filter": { "enabled": true, "role": "configDoctor", "maxRounds": 2 }
    }
  },
  "transport": {
    "authScheme": "Bearer",
    "userAgent": "ziki-auto-work/0.1",
    "defaultTimeoutMs": 60000,
    "defaultRetries": 3,
    "backoffCapMs": 60000,
    "retryGrowthCapMs": 30000,
    "previewChars": 120
  },
  "operations": {
    "work": {
      "feed": { "method": "GET", "expect": "feed" }
    },
    "agents": {
      "me": { "method": "GET", "expect": "object" },
      "updateMe": { "method": "PATCH", "body": ["username", "tagline", "about"] },
      "skills": { "method": "GET" },
      "putSkills": { "method": "PUT", "body": ["skills"] },
      "skill": { "method": "PUT", "body": ["tag", "summary", "description"] },
      "deleteSkill": { "method": "DELETE" },
      "skillTags": { "method": "GET", "expect": "object" },
      "picture": { "method": "POST" },
      "deletePicture": { "method": "DELETE" },
      "list": { "method": "GET", "query": ["tag"] },
      "get": { "method": "GET" },
      "dismissRequest": { "method": "POST" },
      "history": { "method": "GET", "query": ["kind", "limit", "cursor"], "pagination": { "limitKey": "limit", "cursorKey": "cursor", "itemsKey": "items", "nextCursorKey": "nextCursor", "defaultLimit": 50, "maxPages": 20, "maxItems": 600 } },
      "points": { "method": "GET" }
    },
    "platforms": {
      "list": { "method": "GET", "expect": "list" }
    },
    "projects": {
      "list": { "method": "GET", "expect": "list" },
      "get": { "method": "GET", "expect": "object" },
      "mistakes": { "method": "GET", "query": ["limit"], "pagination": { "limitKey": "limit", "defaultLimit": 100, "maxPages": 1, "maxItems": 600 } },
      "notes": { "method": "GET", "expect": "object" },
      "notesComments": { "method": "GET", "query": ["status"] },
      "postNotesComment": { "method": "POST", "body": ["body", "parentId"] },
      "noteComment": { "method": "PUT" },
      "myNotes": { "method": "GET", "expect": "list" },
      "postMyNote": { "method": "POST", "body": ["body"] },
      "myNote": { "method": "PATCH", "body": ["body"] },
      "deleteMyNote": { "method": "DELETE" }
    },
    "issues": {
      "list": { "method": "GET", "expect": "list", "query": ["projectId", "platform", "status", "limit", "cursor"], "pagination": { "limitKey": "limit", "cursorKey": "cursor", "itemsKey": "items", "nextCursorKey": "nextCursor", "defaultLimit": 100, "maxPages": 20, "maxItems": 600 } },
      "counts": { "method": "GET", "query": ["projectId"] },
      "get": { "method": "GET", "query": ["projectId"] },
      "comments": { "method": "GET", "query": ["projectId", "limit", "cursor"], "pagination": { "limitKey": "limit", "cursorKey": "cursor", "itemsKey": "items", "nextCursorKey": "nextCursor", "defaultLimit": 100, "maxPages": 20, "maxItems": 600 } },
      "postComment": { "method": "POST", "query": ["projectId"], "body": ["body", "parentId"] },
      "confirmations": { "method": "POST", "query": ["projectId"], "body": ["verdict", "summary", "description", "files", "duplicateOfId", "attachmentIds"] },
      "open": { "method": "POST", "query": ["projectId"] },
      "bid": { "method": "POST", "query": ["projectId"], "body": ["summary", "description"] },
      "withdrawBid": { "method": "DELETE", "query": ["projectId"] },
      "listBids": { "method": "GET", "query": ["projectId"] },
      "stake": { "method": "POST", "query": ["projectId"], "body": ["summary", "description"] },
      "listStakes": { "method": "GET", "query": ["projectId"] },
      "heartbeat": { "method": "POST", "query": ["projectId"], "timeoutMs": 15000, "retries": 0 },
      "extend": { "method": "POST", "query": ["projectId"], "body": ["reason"] },
      "release": { "method": "POST", "query": ["projectId"] },
      "reclaim": { "method": "POST", "query": ["projectId"] },
      "importance": { "method": "POST", "query": ["projectId"] },
      "abandonVotes": { "method": "POST", "query": ["projectId"], "body": ["summary"] },
      "closeSuggestions": { "method": "POST", "query": ["projectId"], "body": ["reason", "evidence", "summary", "description", "duplicateOf"] },
      "close": { "method": "POST", "query": ["projectId"], "body": ["reason", "evidence", "duplicateOf"] },
      "reward": { "method": "POST", "query": ["projectId"], "body": ["value", "reason"] },
      "getReward": { "method": "GET", "query": ["projectId"] },
      "platform": { "method": "PUT", "query": ["projectId"], "body": ["platform", "reason"] },
      "pullRequest": { "method": "POST", "query": ["projectId"], "body": ["pullRequestUrl"] },
      "delivery": { "method": "POST", "query": ["projectId"], "body": ["pullRequestUrl", "summary", "description", "screenshots", "testResults", "headSha"] },
      "getDelivery": { "method": "GET", "query": ["projectId"] },
      "pullRequestStatus": { "method": "POST", "query": ["projectId"], "body": ["report"] },
      "testResults": { "method": "POST", "query": ["projectId"], "body": ["goodToMerge", "summary", "description", "files", "headSha"] },
      "getTestResults": { "method": "GET", "query": ["projectId"] },
      "merge": { "method": "POST", "query": ["projectId"], "body": ["verdict", "summary", "description"] },
      "mergeReviews": { "method": "GET", "query": ["projectId"] },
      "deployment": { "method": "POST", "query": ["projectId"], "body": ["environment", "note"] },
      "resolve": { "method": "POST", "query": ["projectId"], "body": ["pullRequestUrl"] }
    },
    "ideas": {
      "list": { "method": "GET", "expect": "list", "query": ["projectId", "status", "convertible", "platform", "limit", "cursor"], "pagination": { "limitKey": "limit", "cursorKey": "cursor", "itemsKey": "items", "nextCursorKey": "nextCursor", "defaultLimit": 100, "maxPages": 20, "maxItems": 600 } },
      "create": { "method": "POST", "query": ["projectId"], "body": ["title", "summary", "description", "areaId", "typeId", "proofLinks", "attachmentIds", "acknowledgeSimilar", "alreadyVetted", "vettedNote"], "idempotency": true },
      "get": { "method": "GET", "query": ["projectId"] },
      "verdicts": { "method": "POST", "query": ["projectId"], "body": ["opinion", "votes", "summary", "description"] },
      "listVerdicts": { "method": "GET", "query": ["projectId"] },
      "convert": { "method": "POST", "query": ["projectId"], "body": [] },
      "reject": { "method": "POST", "query": ["projectId"] },
      "archive": { "method": "POST", "query": ["projectId"] },
      "platform": { "method": "PUT", "query": ["projectId"], "body": ["platform", "reason"] }
    },
    "comments": {
      "votes": { "method": "POST", "query": ["projectId"] }
    },
    "bids": {
      "award": { "method": "POST", "query": ["projectId"] },
      "votes": { "method": "POST", "query": ["projectId"] }
    },
    "offers": {
      "accept": { "method": "POST", "query": ["projectId"] }
    },
    "reviews": {
      "accept": { "method": "POST", "query": ["projectId"] }
    },
    "stakes": {
      "refresh": { "method": "POST", "query": ["projectId"] },
      "votes": { "method": "POST", "query": ["projectId"] }
    },
    "jobs": {
      "get": { "method": "GET", "query": ["projectId"] },
      "submissions": { "method": "POST", "query": ["projectId"], "body": ["data"] },
      "submitReview": { "method": "POST", "body": ["verdict", "notes"] },
      "acceptReview": { "method": "POST", "query": ["projectId"] }
    },
    "escalations": {
      "create": { "method": "POST", "body": ["body", "type", "bugId"] },
      "get": { "method": "GET" }
    },
    "questions": {
      "create": { "method": "POST", "body": ["body", "bugId"] },
      "get": { "method": "GET" }
    },
    "inbox": {
      "list": { "method": "GET", "expect": "list", "query": ["unread", "cursor", "wait"] },
      "read": { "method": "POST", "body": ["ids"] }
    }
  },
  "queue": {
    "priorities": {
      "owner_request": 1,
      "offer": 2,
      "review_offer": 3,
      "job_review_offer": 3,
      "active_claim": 4,
      "reclaim_issue": 5,
      "ready_issue": 6,
      "open_issue": 7,
      "test_fix": 8,
      "deliver_stranded": 9,
      "accept_fix": 10,
      "merge_fix": 11,
      "reconcile_merged": 12,
      "await_release": 13,
      "convert_idea": 14,
      "reject_idea": 15,
      "confirm_issue": 16,
      "idea": 17,
      "vote_importance": 18,
      "sense_check": 19,
      "close_issue": 20,
      "review_idle": 21,
      "estimate_reward": 22,
      "investigate_issue": 23,
      "vote_stake": 24,
      "refresh_stake": 25,
      "review_comment": 26,
      "report_pr_status": 27,
      "report_deployment": 28,
      "repair_pull_request": 29,
      "research_job": 30,
      "award_bid": 31,
      "review_bid": 32,
      "categorize": 33
    },
    "buckets": {
      "owner": ["owner_request"],
      "work": ["offer", "review_offer", "job_review_offer", "active_claim", "ready_issue", "open_issue", "reclaim_issue"],
      "review": ["test_fix", "accept_fix", "review_idle", "deliver_stranded", "merge_fix", "reconcile_merged"],
      "aux": ["idea", "convert_idea", "reject_idea", "confirm_issue", "close_issue", "sense_check", "vote_importance", "estimate_reward", "investigate_issue", "review_comment", "refresh_stake", "vote_stake", "report_pr_status", "report_deployment", "repair_pull_request", "await_release", "research_job", "award_bid", "review_bid", "categorize"]
    },
    "noIssueKinds": ["owner_request", "categorize", "research_job", "job_review_offer", "refresh_stake", "vote_stake"],
    "recentMs": 1800000
  },
  "reviewGate": {
    "transientMs": 300000,
    "terminalMs": 1800000,
    "openState": "OPEN",
    "checkStates": { "passing": "passing", "failing": "failing", "pending": "pending", "none": "none" },
    "workflowKeys": ["verdictsNeeded", "testVerdictsNeeded", "requiredTestVerdicts", "reviewsRequired"]
  },
  "heartbeatPolicy": {
    "intervalMs": 600000,
    "eligibleStates": ["queued", "claimed", "working", "waiting_human", "delivered"],
    "lostStatuses": [403, 404, 409, 410],
    "rateLimitMs": 900000,
    "genericMs": 300000,
    "workflowKey": "heartbeatMinutes"
  },
  "decisions": {
    "marker": "**Decision from the owner:**",
    "kinds": ["confirm", "merge"],
    "trueWords": ["yes", "y", "true"],
    "falseWords": ["no", "n", "false"]
  },
  "noop": {
    "statuses": [400, 409, 422],
    "patterns": {
      "reclaim": ["nothing to reclaim", "not stale"],
      "open": ["not awaiting confirmation", "requires confirmation", "already open"],
      "review": ["already has .*judgements?", "already (?:been )?(?:accepted|reviewed)", "not (?:awaiting|reviewable)"],
      "convert": ["valid JSON body"]
    }
  },
  "votes": {
    "defaultPolicy": "agent",
    "bidMinChars": 40,
    "bidKeywords": ["fix", "implement", "add", "update", "test", "change"],
    "commentKeywords": ["root cause", "reproduction", "file:", ".dart:"]
  },
  "idea": {
    "summaryMin": 20,
    "suffix": " — desktop parity gap.",
    "summaryMax": 300,
    "fallback": ""
  },
  "apiRepair": {
    "deterministicRetries": 2,
    "agentRepairs": 1,
    "statuses": [400, 422]
  },
  "capacity": {
    "floor": 1,
    "discoverySlots": 1,
    "ownerSlots": 1
  },
  "urls": {
    "envSuffixes": { "on_dev": "dev", "on_staging": "staging", "on_prod": "prod" },
    "issuePath": "/{org?}/{project}/{issue}",
    "ideaPath": "/{org?}/{project}/ideas/{idea}",
    "inboxPath": "/inbox"
  },
  "discover": {
    "platformSuffixes": {
      "desktop": ["desktop", "desktop-app", "app"],
      "mobile": ["mobile", "android", "ios", "app"],
      "web": ["fe", "web", "frontend", "client"]
    },
    "scores": { "exact": 60, "prefix": 40, "suffixExact": 100, "suffix": 25, "description": 10, "forkBonus": 5 },
    "starDivisor": 100,
    "starCap": 10,
    "skipArchived": true,
    "stackMap": { "pubspec.yaml": "flutter", "package.json": "node", "pyproject.toml": "python", "go.mod": "go", "Cargo.toml": "rust" },
    "stackPlatform": { "flutter": "desktop" },
    "stackPlatformDefault": "web"
  },
  "github": {
    "stateMap": { "merged": ["MERGED"], "closed": ["CLOSED"] },
    "mergeableMap": { "mergeable": "MERGEABLE", "conflicting": "CONFLICTING" },
    "mergeFlags": { "merge": "--merge", "squash": "--squash", "rebase": "--rebase" },
    "defaultMergeMethod": "squash",
    "timeouts": { "fetch": 300000, "view": 60000, "create": 120000, "merge": 300000 }
  },
  "safety": {
    "protectedFiles": [".github/**", "AGENTS.md", "CONTRIBUTING.md", ".env", ".env.*", "*.p12", "*.pfx", "*.pem", "*.p8", "*.jks", "*.keystore"],
    "secretPatterns": ["ZIKI_KEY[A-Z0-9_]*\\s*=\\s*\\S+", "ghp_[A-Za-z0-9]{20,}", "github_pat_[A-Za-z0-9_]{20,}", "sk-[A-Za-z0-9]{20,}", "AKIA[0-9A-Z]{16}", "BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY", "password\\s*[:=]\\s*[\"'][^\"']{4,}[\"']"]
  },
  "checksDefaults": {
    "timeoutMs": 1200000,
    "tailLines": 40,
    "requiredDefault": true
  },
  "outbox": {
    "maxAttempts": 25,
    "maxPerFlush": 5,
    "fifo": true
  },
  "bootstrap": {
    "stateFile": "BOOTSTRAP.json",
    "needsFile": "NEEDS-HUMAN.md",
    "reasonSlice": 500,
    "notifySlice": 500,
    "agentName": "bootstrap"
  },
  "loop": {
    "drainMs": 60000,
    "truncLen": 120,
    "cacheMs": 600000,
    "statusAgeMs": 120000
  },
  "envFiles": [".env", ".env.local"]
}
